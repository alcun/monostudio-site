---
import AppLayout from '../layouts/AppLayout.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
---

<AppLayout
  icon="/icons/bins.png"
  name="Bins"
  tagline="Which bin is it this week?"
  description="Knows which bin goes out this week and reminds you the night before. No account, no postcode."
  status="on the app store"
  appStoreUrl="https://apps.apple.com/gb/app/bins-bin-day-reminder/id6785244443"
>

  <ScreenshotGallery images={[
    { src: '/bins/1-which-bin.jpg', thumb: '/bins/thumb/1-which-bin.jpg', alt: 'Bins - which bin is it this week? The home screen with the next collection', width: 1320, height: 2868 },
    { src: '/bins/2-reminder.jpg', thumb: '/bins/thumb/2-reminder.jpg', alt: 'Bins - the reminder the night before, on the Lock Screen', width: 1320, height: 2868 },
    { src: '/bins/3-done.jpg', thumb: '/bins/thumb/3-done.jpg', alt: 'Bins - one tap on yes, done when the bins are out', width: 1320, height: 2868 },
    { src: '/bins/4-fortnightly.jpg', thumb: '/bins/thumb/4-fortnightly.jpg', alt: 'Bins - weekly and fortnightly bins side by side', width: 1320, height: 2868 },
    { src: '/bins/5-setup.jpg', thumb: '/bins/thumb/5-setup.jpg', alt: 'Bins - setting a bin up in thirty seconds', width: 1320, height: 2868 },
  ]} />
</AppLayout>
