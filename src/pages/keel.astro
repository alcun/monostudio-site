---
import AppLayout from '../layouts/AppLayout.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
---

<AppLayout
  icon="/icons/keel.png"
  name="Keel"
  tagline="See the trend."
  description="Log your weight once a day and watch the seven-day average. Nothing leaves your phone."
  status="on the app store"
  appStoreUrl="https://apps.apple.com/app/keel-weight-tracker/id6761394184"
>

  <ScreenshotGallery images={[
    { src: '/keel/1.1.0/01-trend.png', alt: 'Keel - daily weigh-ins and seven-day trend', width: 1320, height: 2868 },
    { src: '/keel/1.1.0/02-log.png', alt: 'Keel - log a weight', width: 1320, height: 2868 },
    { src: '/keel/1.1.0/03-apple-health.png', alt: 'Keel - Apple Health integration', width: 1320, height: 2868 },
    { src: '/keel/1.1.0/04-pounds.png', alt: 'Keel - weight in pounds', width: 1320, height: 2868 },
    { src: '/keel/1.1.0/05-reminder.png', alt: 'Keel - optional gentle reminder', width: 1320, height: 2868 },
    { src: '/keel/1.1.0/06-target-reached.png', alt: 'Keel - target reached with a gold average line', width: 1320, height: 2868 },
  ]} />
</AppLayout>
