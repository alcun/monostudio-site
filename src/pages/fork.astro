---
import AppLayout from '../layouts/AppLayout.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
---

<AppLayout
  name="Fork"
  tagline="Stillness means in tune."
  description="A tuner that does one thing well. Play a string and the note settles, the screen goes still, and that stillness is how you know you're in tune. Choose guitar, bass or ukulele for automatic string detection, or chromatic for any note. Set the reference pitch from 430 to 450 Hz, 432 included. Audio is processed on your device and never recorded or sent anywhere. No ads, accounts or analytics."
  status="on the app store"
  appStoreUrl="https://apps.apple.com/app/fork-chromatic-tuner/id6772554425"
  icon="/icons/fork.png"
  review={{ quote: 'Tuner works well. Simple interface. Use it often.', author: 'LeoSteelRock', source: 'App Store review' }}
>
  <ScreenshotGallery images={[
    { src: '/fork/1-chromatic.jpg', alt: 'Fork - chromatic mode', width: 1320, height: 2868 },
    { src: '/fork/2-guitar.jpg', alt: 'Fork - guitar string settled in tune', width: 1320, height: 2868 },
    { src: '/fork/3-instruments.jpg', alt: 'Fork - choose guitar, bass, ukulele or chromatic', width: 1320, height: 2868 },
    { src: '/fork/4-reference-pitch.jpg', alt: 'Fork - reference pitch set to 432 Hz', width: 1320, height: 2868 },
    { src: '/fork/5-bass.jpg', alt: 'Fork - bass mode', width: 1320, height: 2868 },
    { src: '/fork/6-ukulele.jpg', alt: 'Fork - ukulele mode', width: 1320, height: 2868 },
  ]} />
</AppLayout>
