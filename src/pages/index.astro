---
import BaseLayout from '../layouts/BaseLayout.astro';

type Status = 'live' | 'beta' | 'review' | 'soon';
const label: Record<Status, string> = { live: 'On the App Store', beta: 'Beta', review: 'In review', soon: 'Coming soon' };
const statusText: Record<Status, string> = { live: 'on the App Store', beta: 'in TestFlight', review: 'in App Review', soon: 'coming soon' };

// Grouped by where each app is, then in the order Al set. Live apps use the
// artwork from their App Store listing; the rest use the project's icon.png.
const apps: { slug: string; name: string; tagline: string; status: Status; icon?: string; glyph?: string }[] = [
  { slug: 'fork', name: 'Fork', tagline: 'Guitar, bass and ukulele', status: 'live', icon: '/icons/fork.png' },
  { slug: 'keel', name: 'Keel', tagline: 'See the trend.', status: 'live', icon: '/icons/keel.png' },
  { slug: 'bins', name: 'Bins', tagline: 'Did you take the bins out?', status: 'live', icon: '/icons/bins.png' },
  { slug: 'lune', name: 'Lune', tagline: 'Moon phases and calendar', status: 'beta', icon: '/icons/lune.png' },
  { slug: 'enso', name: 'Enso', tagline: 'One stroke, every day.', status: 'beta', icon: '/icons/enso.png' },
  { slug: 'tide', name: 'Tide', tagline: 'Tide times for your coast', status: 'soon', icon: '/icons/tide.png' },
  { slug: 'dose', name: 'Dose', tagline: 'One a day. Did you?', status: 'soon', icon: '/icons/dose.png' },
  { slug: 'grateful', name: 'Grateful', tagline: 'One thing, every day.', status: 'soon', glyph: '<svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"> <circle cx="30" cy="30" r="3.5" fill="currentColor"></circle> </svg>' },
  { slug: 'bare-minimum', name: 'Bare Minimum', tagline: "Three things. That's it.", status: 'soon', glyph: '<svg viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"> <line x1="18" y1="22" x2="42" y2="22"></line> <line x1="18" y1="30" x2="42" y2="30"></line> <line x1="18" y1="38" x2="42" y2="38"></line> </svg>' },
];
const live = apps.filter((app) => app.status === 'live');
const coming = apps.filter((app) => app.status !== 'live');
---

<BaseLayout title="Mono Studio - One thing, done well.">
  <style>
    .fade-in {
      opacity: 0;
      animation: breatheIn 0.8s ease-out forwards;
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
      padding: 0 32px;
    }

    .ambient {
      display: none;
    }

    .aura { position: absolute; border-radius: 50%; filter: blur(72px); }
    .aura-one { width: 340px; height: 340px; left: -120px; top: 40px; background: var(--primary-soft); }
    .aura-two { width: 430px; height: 430px; right: -160px; top: 360px; background: var(--accent); }
    .aura-three { width: 360px; height: 360px; left: 30%; bottom: 100px; background: var(--primary-soft); opacity: 0.55; }

    /* ---- Hero ---- */
    .hero {
      padding: 96px 0 0;
      text-align: center;
    }

    .hero .fade-in:nth-child(1) { animation-delay: 0.1s; }
    .hero .fade-in:nth-child(2) { animation-delay: 1.8s; }
    .hero .fade-in:nth-child(3) { animation-delay: 2.2s; }

    .enso-mark {
      width: 120px;
      height: 120px;
      margin: 0 auto 48px;
      position: relative;
    }

    .enso-mark svg {
      width: 100%;
      height: 100%;
    }

    /* the brush paints here; the svg underneath is the no-JS mark and is hidden
       the moment the script takes over */
    .enso-mark canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    :global(:root[data-theme="dark"]) .enso-mark canvas { filter: invert(1) brightness(1.45); }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme="light"])) .enso-mark canvas { filter: invert(1) brightness(1.45); }
    }

    @keyframes drawEnso {
      from { stroke-dashoffset: 380; }
      to { stroke-dashoffset: 0; }
    }

    .enso-stroke {
      stroke-dasharray: 380;
      stroke-dashoffset: 380;
      animation: drawEnso 2s cubic-bezier(0.25, 0.1, 0.25, 1) 0.3s forwards;
    }

    .wordmark {
      font-family: "Noto Serif JP", serif;
      font-weight: 200;
      font-size: 38px;
      letter-spacing: 0.08em;
      color: var(--text);
    }

    .philosophy {
      margin-top: 24px;
      font-size: 16px;
      font-weight: 300;
      color: var(--text-soft);
      line-height: 1.9;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ---- Divider ---- */
    .breath {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 72px 0;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 2.8s forwards;
    }

    .breath-line { width: 40px; height: 1px; background: var(--stone); }

    .breath-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--stone);
      margin: 0 16px;
    }

    /* ---- Apps ---- */
    .apps-section { padding-bottom: 80px; }

    .section-label {
      font-family: "Noto Serif JP", serif;
      font-weight: 300;
      font-size: 12px;
      letter-spacing: 3px;
      color: var(--text-faint);
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 40px;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 3s forwards;
    }

    /* Two tiers. What is on the App Store gets a feature tile: a big icon on a
       glow taken from the icon itself, the name in the wordmark's serif. Beta and
       coming-soon apps sit below as quieter compact tiles with a status dot, no
       buttons. Icons keep their own colours in dark mode, as on iOS. */
    .apps {
      --native: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Karla, system-ui, sans-serif;
      --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* the cards arrive one after another, a breath apart, in reading order */
    .app-grid > li,
    .group-label {
      opacity: 0;
      animation: breatheIn 0.7s ease-out forwards;
      animation-delay: calc(3.1s + var(--i, 0) * 0.08s);
    }

    .app-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
    .app-grid > li { display: flex; }
    .app-grid .app-card { flex: 1; min-width: 0; }
    .app-grid.featured { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .app-grid.compact { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }

    /* set like the "Apps" label above it, one step quieter */
    .group-label {
      font-family: "Noto Serif JP", serif;
      font-weight: 300;
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--text-faint);
      text-align: center;
      margin: 64px 0 24px;
    }

    .app-card {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: flex;
      color: inherit;
      text-decoration: none;
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: inset 0 1px 0 var(--glass-highlight), 0 1px 2px rgba(42, 42, 40, 0.04), 0 18px 40px -30px var(--glass-shadow);
      backdrop-filter: blur(22px) saturate(165%);
      -webkit-backdrop-filter: blur(22px) saturate(165%);
      transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.3s ease;
    }

    /* the app's own colour, blurred into the top of its card */
    .app-card::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: -30% -10% auto;
      height: 90%;
      background: var(--icon) center / cover no-repeat;
      filter: blur(46px) saturate(140%);
      opacity: 0.22;
      transition: opacity 0.5s var(--ease), transform 0.8s var(--ease);
    }

    .app-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--text) 16%, transparent);
      box-shadow: inset 0 1px 0 var(--glass-highlight), 0 1px 2px rgba(42, 42, 40, 0.05), 0 30px 60px -34px var(--glass-shadow);
    }
    .app-card:hover::before { opacity: 0.34; transform: scale(1.08); }
    .app-card:active { transform: scale(0.985); transition-duration: 0.12s; }
    .app-card:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 3px; }

    .app-icon {
      position: relative;
      flex: none;
      width: 64px;
      height: 64px;
      border-radius: 22.5%;
      overflow: hidden;
      background: #f4ede0;
      color: #2a2a28;
      display: grid;
      place-items: center;
      box-shadow: 0 1px 1px rgba(42, 42, 40, 0.08), 0 10px 22px -12px rgba(42, 42, 40, 0.5);
      transition: transform 0.6s var(--ease);
    }
    .app-icon::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(42, 42, 40, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }
    .app-icon img { width: 100%; height: 100%; display: block; }
    .app-icon :global(svg) { width: 60%; height: 60%; display: block; }

    .app-name {
      display: block;
      font-family: "Noto Serif JP", serif;
      font-weight: 400;
      letter-spacing: 0.01em;
      color: var(--text);
    }
    .app-tagline {
      display: block;
      font-family: var(--native);
      color: var(--text-soft);
      line-height: 1.4;
    }

    /* ---- featured: live on the App Store ---- */
    .featured .app-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 28px 26px 22px;
      border-radius: 30px;
    }
    .featured .app-icon { width: 88px; height: 88px; margin-bottom: 22px; }
    .featured .app-card:hover .app-icon { transform: translateY(-2px) rotate(-3deg) scale(1.04); }
    .featured .app-name { font-size: 24px; line-height: 1.2; }
    .featured .app-tagline { margin-top: 6px; font-size: 15px; }

    .app-store {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      margin-top: auto;
      padding-top: 22px;
      font-family: var(--native);
      font-size: 13px;
      font-weight: 500;
      color: var(--sage-deep);
    }
    .app-store .rule { flex: 1; height: 1px; background: var(--border); }
    .app-store svg { width: 14px; height: 14px; transition: transform 0.5s var(--ease); }
    .app-card:hover .app-store svg { transform: translateX(4px); }

    .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: var(--sage); box-shadow: 0 0 0 3px var(--sage-soft); }
    .dot.beta { background: var(--amber); box-shadow: 0 0 0 3px color-mix(in srgb, var(--amber) 20%, transparent); }
    .dot.soon { background: var(--stone); box-shadow: none; }

    /* ---- compact: beta and coming soon ---- */
    .compact .app-card {
      align-items: center;
      gap: 14px;
      padding: 14px 16px 14px 14px;
      border-radius: 22px;
    }
    .compact .app-card::before { opacity: 0.14; }
    .compact .app-card:hover::before { opacity: 0.24; }
    .compact .app-card:hover .app-icon { transform: scale(1.05); }
    .compact .app-icon { width: 52px; height: 52px; }
    .compact .app-name { font-size: 16px; line-height: 1.3; }
    .compact .app-tagline { margin-top: 2px; font-size: 13px; }
    .compact .soon .app-icon { filter: saturate(0.6); opacity: 0.85; transition: transform 0.6s var(--ease), filter 0.4s ease, opacity 0.4s ease; }
    .compact .soon:hover .app-icon { filter: none; opacity: 1; }

    .app-status {
      display: flex;
      align-items: center;
      gap: 7px;
      margin-top: 6px;
      font-family: var(--native);
      font-size: 12px;
      color: var(--text-faint);
    }

    /* ---- Footer ---- */
    .footer {
      padding: 48px 0 64px;
      text-align: center;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 4.4s forwards;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 32px;
      margin-bottom: 24px;
    }

    .footer-links a {
      font-size: 12px;
      color: var(--text-faint);
      text-decoration: none;
      letter-spacing: 0.5px;
      transition: color 0.3s ease;
    }

    .footer-links a:hover { color: var(--text-soft); }

    .footer-copy {
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: 0.5px;
    }

    .footer-copy a {
      color: inherit;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-copy a:hover { color: var(--text-soft); }

    @media (max-width: 900px) and (min-width: 681px) {
      .app-grid.compact { grid-template-columns: 1fr 1fr; }
      .featured .app-card { padding: 24px 20px 20px; }
    }

    @media (max-width: 680px) {
      .hero { padding: 80px 0 0; }
      .wordmark { font-size: 30px; }
      .philosophy { font-size: 15px; }
      .breath { padding: 56px 0; }
      .app-grid.featured, .app-grid.compact { grid-template-columns: 1fr; gap: 12px; }
      .featured .app-card { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 0 16px; padding: 18px 18px 16px; border-radius: 24px; }
      .featured .app-icon { width: 68px; height: 68px; margin: 0; }
      .featured .app-text { flex: 1; min-width: 0; }
      .featured .app-name { font-size: 20px; }
      .featured .app-tagline { font-size: 14px; }
      .app-store { flex-basis: 100%; padding-top: 14px; }
      .group-label { margin: 44px 0 16px; }
      .container { padding: 0 24px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .app-card,
      .app-card::before,
      .app-icon,
      .app-store svg { transition: none; }
      .app-card:hover,
      .app-card:active,
      .app-card:hover::before,
      .app-card:hover .app-icon,
      .app-card:hover .app-store svg { transform: none; }
    }

    :global(:root[data-home-return]) .fade-in,
    :global(:root[data-home-return]) .breath,
    :global(:root[data-home-return]) .section-label,
    :global(:root[data-home-return]) .app-grid > li,
    :global(:root[data-home-return]) .group-label,
    :global(:root[data-home-return]) .footer {
      opacity: 1;
      animation: none;
    }
  </style>

  <main>
  <div class="ambient" aria-hidden="true">
    <div class="aura aura-one"></div>
    <div class="aura aura-two"></div>
    <div class="aura aura-three"></div>
  </div>

  <div class="container">
    <section class="hero">
      <div class="fade-in enso-mark">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            class="enso-stroke"
            d="M 96 168 A 60 60 0 1 1 104 168"
            stroke="currentColor"
            stroke-width="8"
            stroke-linecap="round"
            fill="none"
          ></path>
        </svg>
        <canvas id="ensoBrush" aria-hidden="true"></canvas>
      </div>

      <div class="fade-in">
        <h1 class="wordmark">Mono Studio</h1>
      </div>

      <div class="fade-in">
        <p class="philosophy">
          One thing, done well.
        </p>
      </div>
    </section>

    <div class="breath">
      <div class="breath-line"></div>
      <div class="breath-dot"></div>
      <div class="breath-line"></div>
    </div>

    <section class="apps-section">
      <p class="section-label">Apps</p>
      <div class="apps">
        <ul class="app-grid featured">
          {live.map((app, i) => (
            <li style={`--i: ${i}`}>
              <a href={`/${app.slug}`} class="app-card" style={app.icon ? `--icon: url(${app.icon})` : undefined} aria-label={`${app.name}, ${statusText[app.status]}`}>
                <span class="app-icon" aria-hidden="true">
                  {app.icon ? <img src={app.icon} alt="" width="88" height="88" /> : <Fragment set:html={app.glyph} />}
                </span>
                <span class="app-text">
                  <span class="app-name">{app.name}</span>
                  <span class="app-tagline">{app.tagline}</span>
                </span>
                <span class="app-store" aria-hidden="true">
                  <span class="dot"></span>
                  On the App Store
                  <span class="rule"></span>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="group-label" style={`--i: ${live.length}`}>In the works</p>
        <ul class="app-grid compact">
          {coming.map((app, i) => (
            <li style={`--i: ${live.length + 1 + i}`}>
              <a href={`/${app.slug}`} class={`app-card ${app.status}`} style={app.icon ? `--icon: url(${app.icon})` : undefined} aria-label={`${app.name}, ${statusText[app.status]}`}>
                <span class="app-icon" aria-hidden="true">
                  {app.icon ? <img src={app.icon} alt="" width="52" height="52" loading="lazy" /> : <Fragment set:html={app.glyph} />}
                </span>
                <span class="app-text">
                  <span class="app-name">{app.name}</span>
                  <span class="app-tagline">{app.tagline}</span>
                  <span class="app-status" aria-hidden="true"><span class={`dot ${app.status}`}></span>{label[app.status]}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div class="breath">
      <div class="breath-line"></div>
      <div class="breath-dot"></div>
      <div class="breath-line"></div>
    </div>

    <footer class="footer">
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="mailto:hello@monostudio.site">Contact</a>
      </div>
      <p class="footer-copy">© 2026 Mono Studio · <a href="https://alcun.dev" target="_blank" rel="noopener">alcun.dev</a></p>
    </footer>
  </div>
  </main>
</BaseLayout>

<script>
  // The mark, drawn with a brush instead of a stroked path. Geometry is read
  // straight off the svg's own arc (M 96 168 A 60 60 0 1 1 104 168), so the logo
  // keeps its shape and only gains a hand: the width comes from how fast the
  // stroke is moving, and the ink runs out as it goes round.
  import { EnsoBrush, arcLength, type Point } from "../lib/brush";

  const canvas = document.getElementById("ensoBrush") as HTMLCanvasElement | null;
  const svg = canvas?.parentElement?.querySelector("svg");
  if (canvas) {
    const SIZE = 120;
    const INK = "#2A2A28";
    const CY200 = 168 - Math.sqrt(60 * 60 - 16); // the arc's centre, from the path
    const R = 60 / 200;
    const CX = 100 / 200;
    const CY = CY200 / 200;
    const A0 = Math.atan2(168 - CY200, 96 - 100);
    const A1 = Math.atan2(168 - CY200, 104 - 100);
    // a full turn plus a little, so the dry end crosses back over the wet start
    // and the ring actually closes. The old svg mark stopped 8 degrees short.
    const SWEEP = A1 + Math.PI * 2 - A0 + 0.34;

    // One breath: lands slow and loaded, opens through the middle, away at the
    // end. That last acceleration is what thins the stroke and dries it out, and
    // it is the whole character - a calmer version was tried and read as limp.
    // ~1450ms, widths 22 down to 11 in 320-space.
    function markStroke(): Point[] {
      const pts: Point[] = [];
      const n = 168;
      const step = (SWEEP * R * 320) / n;
      let t = 0;
      for (let i = 0; i <= n; i++) {
        const u = i / n;
        // a hand does not draw a compass circle
        const wob = Math.sin(u * 9.3) * 0.0022 + Math.sin(u * 23.7 + 1.1) * 0.0009;
        const r = R + wob + u * 0.0015;
        const ang = A0 + SWEEP * u;
        const speed = 0.045 + 0.9 * Math.pow(Math.sin(u * Math.PI), 1.6) + Math.pow(u, 6) * 3;
        t += step / speed;
        pts.push([
          Math.round((CX + Math.cos(ang) * r) * 1e4) / 1e4,
          Math.round((CY + Math.sin(ang) * r) * 1e4) / 1e4,
          Math.round(t),
        ]);
      }
      return pts;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 3);
    canvas.width = Math.round(SIZE * dpr);
    canvas.height = Math.round(SIZE * dpr);
    const ctx = canvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (svg) (svg as SVGElement).style.display = "none";

    const pts = markStroke();
    const brush = new EnsoBrush(ctx, SIZE, INK);
    const total = pts[pts.length - 1][2];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduced) {
      brush.finish(pts);
    } else {
      // fed, never re-rendered: the brush paints only what is newly drawn, and
      // knowing the length up front lets it taper away at the end on its own
      brush.begin(INK, arcLength(pts));
      const start = performance.now() + 300; // same beat the css animation had
      const step = () => {
        const elapsed = performance.now() - start;
        if (elapsed >= total) {
          brush.seal(pts);
          return;
        }
        if (elapsed > 0) {
          let n = 2;
          while (n < pts.length && pts[n][2] <= elapsed) n++;
          brush.feed(pts.slice(0, n));
        }
        requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }
</script>
