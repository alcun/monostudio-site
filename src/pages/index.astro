---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mono Studio - One thing, done well.">
  <style>
    .fade-in {
      opacity: 0;
      animation: breatheIn 0.8s ease-out forwards;
    }

    .container {
      position: relative;
      z-index: 1;
      max-width: 960px;
      margin: 0 auto;
      padding: 0 32px;
    }

    .ambient {
      display: none;
    }

    .aura { position: absolute; border-radius: 50%; filter: blur(72px); }
    .aura-one { width: 340px; height: 340px; left: -120px; top: 40px; background: var(--primary-soft); }
    .aura-two { width: 430px; height: 430px; right: -160px; top: 360px; background: var(--accent); }
    .aura-three { width: 360px; height: 360px; left: 30%; bottom: 100px; background: var(--primary-soft); opacity: 0.55; }

    /* ---- Hero ---- */
    .hero {
      padding: 96px 0 0;
      text-align: center;
    }

    .hero .fade-in:nth-child(1) { animation-delay: 0.1s; }
    .hero .fade-in:nth-child(2) { animation-delay: 1.8s; }
    .hero .fade-in:nth-child(3) { animation-delay: 2.2s; }

    .enso-mark {
      width: 120px;
      height: 120px;
      margin: 0 auto 48px;
      position: relative;
    }

    .enso-mark svg {
      width: 100%;
      height: 100%;
    }

    /* the brush paints here; the svg underneath is the no-JS mark and is hidden
       the moment the script takes over */
    .enso-mark canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    :global(:root[data-theme="dark"]) .enso-mark canvas { filter: invert(1) brightness(1.45); }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme="light"])) .enso-mark canvas { filter: invert(1) brightness(1.45); }
    }

    @keyframes drawEnso {
      from { stroke-dashoffset: 380; }
      to { stroke-dashoffset: 0; }
    }

    .enso-stroke {
      stroke-dasharray: 380;
      stroke-dashoffset: 380;
      animation: drawEnso 2s cubic-bezier(0.25, 0.1, 0.25, 1) 0.3s forwards;
    }

    .wordmark {
      font-family: "Noto Serif JP", serif;
      font-weight: 200;
      font-size: 38px;
      letter-spacing: 0.08em;
      color: var(--text);
    }

    .philosophy {
      margin-top: 24px;
      font-size: 16px;
      font-weight: 300;
      color: var(--text-soft);
      line-height: 1.9;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ---- Divider ---- */
    .breath {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 72px 0;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 2.8s forwards;
    }

    .breath-line { width: 40px; height: 1px; background: var(--stone); }

    .breath-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--stone);
      margin: 0 16px;
    }

    /* ---- Apps ---- */
    .apps-section { padding-bottom: 80px; }

    .section-label {
      font-family: "Noto Serif JP", serif;
      font-weight: 300;
      font-size: 12px;
      letter-spacing: 3px;
      color: var(--text-faint);
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 40px;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 3s forwards;
    }

    .app-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
    }

    .app-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      min-height: 238px;
      transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      opacity: 0;
      animation: breatheIn 0.5s ease-out forwards;
      cursor: pointer;
      text-decoration: none;
      box-shadow: inset 0 1px 0 var(--glass-highlight), inset 0 -1px 0 rgba(45, 50, 72, 0.04), 0 18px 46px -28px var(--glass-shadow);
      backdrop-filter: blur(22px) saturate(165%);
      -webkit-backdrop-filter: blur(22px) saturate(165%);
    }

    .app-card::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(255,255,255,0.24), transparent 44%);
    }

    .app-card > * { position: relative; z-index: 1; }

    .app-card:nth-child(1) { animation-delay: 3.1s; }
    .app-card:nth-child(2) { animation-delay: 3.2s; }
    .app-card:nth-child(3) { animation-delay: 3.3s; }
    .app-card:nth-child(4) { animation-delay: 3.4s; }
    .app-card:nth-child(5) { animation-delay: 3.5s; }
    .app-card:nth-child(6) { animation-delay: 3.6s; }
    .app-card:nth-child(7) { animation-delay: 3.7s; }

    .app-card:hover {
      background-color: color-mix(in srgb, var(--card) 84%, var(--primary-soft));
      border-color: color-mix(in srgb, var(--primary) 16%, var(--border));
      box-shadow: inset 0 1px 0 var(--glass-highlight), inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 18px 46px -28px var(--glass-shadow);
    }

    .app-card:focus-visible {
      outline: 2px solid var(--text-soft);
      outline-offset: 3px;
    }

    .app-card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }

    .app-icon {
      width: 44px;
      height: 44px;
      background: rgba(255, 255, 255, 0.28);
      border: 1px solid var(--glass-highlight);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text);
      flex-shrink: 0;
      /* Colour only. A 44px bordered tile scaled by a fraction lands its border
         and its 12px radius on subpixels, and the 27px glyph inside goes soft
         with it, so the hover read as a shimmer rather than a lift. */
      transition: background 0.2s ease, color 0.2s ease;
    }

    .app-icon svg {
      width: 27px;
      height: 27px;
      display: block;
    }

    .app-card:hover .app-icon {
      background: var(--primary-soft);
      color: var(--primary);
    }

    .app-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding-top: 4px;
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: var(--text-faint);
      white-space: nowrap;
    }

    .app-status::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--stone);
    }

    .app-status.live { color: var(--text-soft); }
    .app-status.live::before { background: var(--sage); }
    .app-status.beta::before { background: var(--amber); }

    .app-copy { margin-top: 22px; }

    .app-name {
      font-family: "Noto Serif JP", serif;
      font-weight: 300;
      font-size: 20px;
      color: var(--text);
      letter-spacing: 0.01em;
      line-height: 1.1;
    }

    .app-tagline {
      display: block;
      margin-top: 6px;
      font-size: 14px;
      font-weight: 300;
      color: var(--text-soft);
      line-height: 1.5;
    }

    .app-footer {
      margin-top: auto;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: var(--text-soft);
      transition: color 0.2s ease;
    }

    .app-arrow {
      width: 16px;
      height: 16px;
      transition: transform 0.2s cubic-bezier(0.2, 0.75, 0.25, 1);
    }

    .app-card:hover .app-footer { color: var(--primary); }
    .app-card:hover .app-arrow { transform: translateX(2px); }

    :global(:root[data-theme="dark"]) .app-card::after { background: none; }
    @media (prefers-color-scheme: dark) {
      :global(:root:not([data-theme="light"])) .app-card::after { background: none; }
    }

    /* ---- Footer ---- */
    .footer {
      padding: 48px 0 64px;
      text-align: center;
      opacity: 0;
      animation: breatheIn 0.6s ease-out 4.4s forwards;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 32px;
      margin-bottom: 24px;
    }

    .footer-links a {
      font-size: 12px;
      color: var(--text-faint);
      text-decoration: none;
      letter-spacing: 0.5px;
      transition: color 0.3s ease;
    }

    .footer-links a:hover { color: var(--text-soft); }

    .footer-copy {
      font-size: 11px;
      color: var(--text-faint);
      letter-spacing: 0.5px;
    }

    .footer-copy a {
      color: inherit;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-copy a:hover { color: var(--text-soft); }

    @media (max-width: 680px) {
      .hero { padding: 80px 0 0; }
      .wordmark { font-size: 30px; }
      .philosophy { font-size: 15px; }
      .breath { padding: 56px 0; }
      .app-grid { grid-template-columns: 1fr; gap: 12px; }
      .app-card {
        padding: 24px 20px;
        min-height: 220px;
        border-radius: 14px;
      }
      .app-name { font-size: 20px; }
      .container { padding: 0 24px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .app-card,
      .app-icon,
      .app-footer,
      .app-arrow { transition: none; }
    }

    :global(:root[data-home-return]) .fade-in,
    :global(:root[data-home-return]) .breath,
    :global(:root[data-home-return]) .section-label,
    :global(:root[data-home-return]) .app-card,
    :global(:root[data-home-return]) .footer {
      opacity: 1;
      animation: none;
    }
  </style>

  <main>
  <div class="ambient" aria-hidden="true">
    <div class="aura aura-one"></div>
    <div class="aura aura-two"></div>
    <div class="aura aura-three"></div>
  </div>

  <div class="container">
    <section class="hero">
      <div class="fade-in enso-mark">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            class="enso-stroke"
            d="M 96 168 A 60 60 0 1 1 104 168"
            stroke="currentColor"
            stroke-width="8"
            stroke-linecap="round"
            fill="none"
          ></path>
        </svg>
        <canvas id="ensoBrush" aria-hidden="true"></canvas>
      </div>

      <div class="fade-in">
        <h1 class="wordmark">Mono Studio</h1>
